# .env
# Path relatif terhadap lokasi file .env berada
SQL_PATH_DEFAULT=database/database.sql
MODEL_PATH_DEFAULT=model
DATABASE_DEFAULT_DRIVER=sqlite
DATABASE_DEFAULT_DATABASE=database/app.db

PG_DRIVER=postgresql
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=my_postgres_db
PG_USER=postgres
PG_PASSWORD=secret_password

MYSQL_DRIVER=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=my_mysql_db
MYSQL_USER=root
MYSQL_PASSWORD=my_password
